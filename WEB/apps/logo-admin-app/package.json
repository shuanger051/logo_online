{
  "name": "@shop-sign/logo-admin-app",
  "version": "1.0.0",
  "description": "logo-admin-app",
  "appName": "logo-admin-app",
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "start": "cross-env NODE_ENV=development PROXY_ENV=dev PLATFORM=electron node ./buildClient/dev.js",
    "build": "cross-env NODE_ENV=production PROXY_ENV=dev PLATFORM=electron  node ./buildClient/build.js",
    "start:web": "cross-env NODE_ENV=development PROXY_ENV=dev PLATFORM=web node ./buildWeb/dev.js",
    "build:web": "cross-env NODE_ENV=production PROXY_ENV=dev PLATFORM=web node ./buildWeb/build.js",
    "server": "node ./updateServer/app.js"
  },
  "license": "ISC",
  "build": {
    "asar": true,
    "productName": "logo-admin-app",
    "appId": "com.electron.template",
    "copyright": "Copyright © template",
    "directories": {
      "output": "pack"
    },
    "files": [
      "app/**"
    ],
    "extraResources": [
      "./resources/**"
    ],
    "mac": {
      "identity": "com.electron.templat",
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}.${ext}",
      "icon": "src/main/favicon/favicon.icns"
    },
    "dmg": {
      "title": "${productName}",
      "artifactName": "${productName}.${ext}",
      "icon": "src/main/favicon/favicon.icns"
    },
    "win": {
      "legalTrademarks": "Copyright © template",
      "requestedExecutionLevel": "highestAvailable",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "artifactName": "${productName}.${ext}",
      "icon": "main/favicon/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "allowElevation": true,
      "artifactName": "${productName}-安装包-V${version}.${ext}",
      "runAfterFinish": true,
      "shortcutName": "logo-admin-app",
      "uninstallDisplayName": "${productName}",
      "guid": "com.template.webpack.vue.electron",
      "language": "2052"
    }
  },
  "devDependencies": {
    "@ant-design/colors": "^4.0.1",
    "@antv/data-set": "^0.11.4",
    "@babel/core": "^7.9.6",
    "@babel/preset-env": "^7.9.6",
    "@electron/remote": "^2.0.9",
    "@shop-sign/editor": "workspace:*",
    "@vue/babel-helper-vue-jsx-merge-props": "^1.0.0",
    "@vue/babel-preset-jsx": "^1.0.0",
    "adm-zip": "^0.4.14",
    "animate.css": "^4.1.0",
    "ant-design-vue": "1.7.2",
    "archiver": "^4.0.1",
    "autoprefixer": "^9.7.6",
    "axios": "^0.19.2",
    "babel-loader": "^8.1.0",
    "cookie": "^1.0.2",
    "cross-env": "^7.0.3",
    "css-hot-loader": "^1.4.4",
    "css-loader": "^3.5.3",
    "electron": "^24.2.0",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^3.2.0",
    "electron-settings": "^4.0.2",
    "fast-deep-equal": "^3.1.3",
    "file-loader": "^6.0.0",
    "fs-extra": "^11.1.1",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.5.1",
    "koa": "^2.15.3",
    "koa-static": "^5.0.0",
    "less": "^3.11.1",
    "less-loader": "^6.1.0",
    "lodash": "^4.17.21",
    "lodash.clonedeep": "^4.5.0",
    "markdown-loader": "^8.0.0",
    "marked": "^5.0.1",
    "mini-css-extract-plugin": "^2.7.5",
    "moment": "^2.29.4",
    "node-stream-zip": "^1.15.0",
    "nprogress": "^0.2.0",
    "postcss-loader": "^3.0.0",
    "progress-bar-webpack-plugin": "^2.1.0",
    "quill": "^1.3.7",
    "style-resources-loader": "^1.3.2",
    "url": "^0.11.0",
    "url-loader": "^4.1.0",
    "view-design": "^4.7.0",
    "vue": "^2.7.14",
    "vue-i18n": "^8.18.2",
    "vue-loader": "^15.9.2",
    "vue-quill-editor": "^3.0.6",
    "vue-router": "^3.1.6",
    "vue-template-compiler": "^2.6.11",
    "vuex": "^3.4.0",
    "webpack": "^5.82.0",
    "webpack-dev-server": "^4.15.0"
  },
  "dependencies": {
    "ali-oss": "^6.22.0",
    "core-js": "^3.6.5",
    "dotenv-webpack": "^8.1.0",
    "sass": "^1.87.0",
    "sass-loader": "10.4.1"
  }
}
